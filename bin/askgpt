#!/usr/bin/env python3
"""ask-gpt: independent GPT review for Claude Code, via the Codex CLI."""

import argparse
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from askgpt import (
    codex, gitctx, preflight, prompts, runner, secrets, state, transcript, usage,
)
from askgpt.artifacts import Artifacts
from askgpt.errors import AskGptError

REPO_ROOT = Path(__file__).resolve().parent.parent

def state_dir():
    """Where thread ids live.

    NOT inside the repo: an installed checkout may be read-only or shared, and
    writing runtime state into it pollutes the working tree that this very tool
    is asked to review. Overridable so tests never touch the real one.
    """
    return Path(os.environ.get("ASKGPT_STATE_DIR", Path.home() / ".askgpt"))


def add_common(parser):
    parser.add_argument("--dry-run", action="store_true", help="Build the payload; send nothing.")
    parser.add_argument("--keep", action="store_true", help="Keep payload/response files.")
    parser.add_argument("--model", default=runner.MODEL)
    parser.add_argument("--allow-secrets", action="store_true")
    parser.add_argument(
        "--allow-sensitive-files",
        action="store_true",
        help="Proceed even though sensitive files are readable by Codex.",
    )
    parser.add_argument("--cwd", default=".")
    parser.add_argument("--session-id", default=os.environ.get("ASKGPT_CLAUDE_SESSION"))


def build_parser():
    parser = argparse.ArgumentParser(prog="askgpt", description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)

    review = sub.add_parser("review", help="Adversarial review of the current change")
    group = review.add_mutually_exclusive_group()
    group.add_argument("--base", metavar="BRANCH")
    group.add_argument("--commit", metavar="SHA")
    group.add_argument("--uncommitted", action="store_true")
    review.add_argument("--task")
    review.add_argument("--task-file")
    add_common(review)

    ask = sub.add_parser("ask", help="Ask GPT anything, with conversation context")
    ask.add_argument("question")
    add_common(ask)

    sub.add_parser("usage", help="Show remaining ChatGPT plan quota (costs nothing)")

    follow = sub.add_parser("follow", help="Continue the last GPT thread")
    follow.add_argument("text")
    add_common(follow)

    return parser


def dispatch(args, payload, resume_thread=None):
    """Shared tail: scan, preflight, dispatch, persist, print."""
    repo = Path(args.cwd).resolve()

    if args.model != runner.MODEL:
        # --model is a deliberate escape hatch, so it stays. But the result must
        # not be mistaken for the Sol review the tool exists to obtain.
        print(
            "warning: using --model " + args.model + " instead of " + runner.MODEL
            + ".\n         This is NOT the model this tool pins; judge the output "
              "accordingly.",
            file=sys.stderr,
        )

    findings = secrets.scan(payload)
    if findings and not args.allow_secrets:
        raise AskGptError(secrets.format_findings(findings))

    # A dry run exists to be inspected, so its artifacts always survive.
    with Artifacts(keep=args.keep or args.dry_run) as art:
        payload_path = art.write("payload.md", payload)

        if args.dry_run:
            print("DRY RUN -- nothing sent. Payload kept at " + str(payload_path))
            print()
            print(payload)
            return 0

        # Scan the whole repository, not --cwd. Codex operates inside the
        # enclosing repo and can read files above the requested subdirectory,
        # so scanning only the subdirectory leaves a `.env` one level up
        # exposed while reporting the tree clean.
        hits = preflight.scan_tree(gitctx.repo_root(repo))
        if hits and not args.allow_sensitive_files:
            # Halt, do not narrate. Printing a warning and dispatching in the
            # same breath is not a protection: by the time the user reads it
            # the repository has already been sent, and under Claude Code the
            # output may not surface until Codex has finished.
            raise AskGptError(
                preflight.format_warning(hits)
                + "\n\nNothing was sent. Re-run with --allow-sensitive-files "
                  "if Codex reading these is acceptable."
            )

        codex_bin = codex.find_codex()
        codex.check_auth(codex_bin)

        result = runner.run(
            codex_bin,
            payload,
            cwd=repo,
            out_path=art.path("out.md"),
            model=args.model,
            resume_thread=resume_thread,
        )

        thread_key = args.session_id or getattr(args, "_fallback_session", None)
        if result.thread_id and thread_key:
            state.save_thread(state_dir(), thread_key, result.thread_id)

        if args.keep:
            print("Artifacts kept in " + str(art.dir), file=sys.stderr)

        print(result.text)

        # Codex refreshed its own rate-limit record during that run, so this
        # costs nothing beyond reading a local file.
        footer = usage.format_footer(usage.read_latest(usage.sessions_dir()))
        if footer:
            print(footer, file=sys.stderr)
    return 0


def cmd_review(args):
    repo = Path(args.cwd).resolve()
    target = gitctx.resolve_target(
        repo, base=args.base, commit=args.commit, uncommitted=args.uncommitted
    )
    branch = gitctx.current_branch(repo)
    task, source = prompts.resolve_task(
        args.task, args.task_file, repo / "docs" / "superpowers" / "specs", branch
    )
    print(
        "Target: " + target.description + " (" + str(len(target.files)) + " files) | "
        "task source: " + source,
        file=sys.stderr,
    )
    payload = prompts.build_review_payload(prompts.load_persona(REPO_ROOT), task, target)
    return dispatch(args, payload)


def _packed_transcript(args):
    if not args.session_id:
        print(
            "warning: no --session-id given; falling back to the newest transcript by "
            "mtime.\n         With two Claude sessions open in this directory that can "
            "select the wrong one.",
            file=sys.stderr,
        )
    config_dir = Path(os.environ.get("CLAUDE_CONFIG_DIR", Path.home() / ".claude"))
    project_dir = transcript.project_dir_for(Path(args.cwd).resolve(), config_dir)
    path = transcript.resolve_session(project_dir, args.session_id)
    # Remember which transcript we actually used, so a follow-up can resume even
    # when no --session-id was given. Otherwise the call succeeds and `follow`
    # then reports "no prior thread" for a conversation that plainly happened.
    args._fallback_session = args.session_id or path.stem
    return transcript.pack(transcript.load_jsonl(path), drop_last_turns=1)


def cmd_ask(args):
    payload = prompts.build_ask_payload(args.question, _packed_transcript(args))
    return dispatch(args, payload)


def cmd_usage(args):
    print(usage.format_usage(usage.read_latest(usage.sessions_dir())))
    return 0


def cmd_follow(args):
    thread_id = state.load_thread(state_dir(), args.session_id or "")
    if not thread_id and not args.session_id:
        # Mirror the ask-path fallback so an unkeyed ask can still be followed.
        try:
            config_dir = Path(os.environ.get("CLAUDE_CONFIG_DIR", Path.home() / ".claude"))
            project_dir = transcript.project_dir_for(Path(args.cwd).resolve(), config_dir)
            thread_id = state.load_thread(
                state_dir(), transcript.resolve_session(project_dir, None).stem
            )
        except AskGptError:
            thread_id = None
    if not thread_id:
        raise AskGptError(
            "No prior GPT thread for this session. Run `askgpt ask` or "
            "`askgpt review` first."
        )
    return dispatch(args, args.text, resume_thread=thread_id)


def main(argv=None):
    args = build_parser().parse_args(argv)
    handler = {
        "review": cmd_review,
        "ask": cmd_ask,
        "follow": cmd_follow,
        "usage": cmd_usage,
    }[args.command]
    try:
        return handler(args)
    except AskGptError as error:
        print("askgpt: " + str(error), file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
