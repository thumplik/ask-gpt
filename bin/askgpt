#!/usr/bin/env python3
"""ask-gpt: independent GPT review for Claude Code, via the Codex CLI."""

import argparse
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from askgpt import (
    codex, gitctx, ledger, preflight, prompts, runner, secrets, state, transcript, usage,
)
from askgpt.artifacts import Artifacts
from askgpt.errors import AskGptError

REPO_ROOT = Path(__file__).resolve().parent.parent

def state_dir():
    """Where thread ids live.

    NOT inside the repo: an installed checkout may be read-only or shared, and
    writing runtime state into it pollutes the working tree that this very tool
    is asked to review. Overridable so tests never touch the real one.
    """
    return Path(os.environ.get("ASKGPT_STATE_DIR", Path.home() / ".askgpt"))


def add_common(parser):
    parser.add_argument("--dry-run", action="store_true", help="Build the payload; send nothing.")
    parser.add_argument("--keep", action="store_true", help="Keep payload/response files.")
    parser.add_argument("--model", default=runner.MODEL)
    parser.add_argument("--allow-secrets", action="store_true")
    parser.add_argument(
        "--no-fallback",
        action="store_true",
        help="Fail instead of falling back to a weaker model.",
    )
    parser.add_argument(
        "--allow-sensitive-files",
        action="store_true",
        help="Proceed even though sensitive files are readable by Codex.",
    )
    parser.add_argument("--cwd", default=".")
    parser.add_argument("--session-id", default=os.environ.get("ASKGPT_CLAUDE_SESSION"))


def build_parser():
    parser = argparse.ArgumentParser(prog="askgpt", description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)

    review = sub.add_parser("review", help="Adversarial review of the current change")
    group = review.add_mutually_exclusive_group()
    group.add_argument("--base", metavar="BRANCH")
    group.add_argument("--commit", metavar="SHA")
    group.add_argument("--uncommitted", action="store_true")
    review.add_argument("--task")
    review.add_argument("--task-file")
    add_common(review)

    ask = sub.add_parser("ask", help="Ask GPT anything, with conversation context")
    ask.add_argument("question")
    add_common(ask)

    sub.add_parser("usage", help="Best-effort snapshot of plan usage so far (costs nothing)")

    acc = sub.add_parser("accept", help="Record a review finding as an accepted risk")
    acc.add_argument("finding_id", metavar="ID", help="The finding's ID, e.g. F2")
    acc.add_argument("reason", help="Why this risk is acceptable")
    acc.add_argument(
        "--description",
        default="",
        help="What the finding WAS (file:line + its own words). Without this the "
             "entry cannot be matched in later reviews, since F-IDs are per-review "
             "ordinals.",
    )
    acc.add_argument("--cwd", default=".")

    unacc = sub.add_parser("unaccept", help="Remove an accepted risk from the ledger")
    unacc.add_argument("finding_id", metavar="ID")
    unacc.add_argument("--cwd", default=".")

    risks = sub.add_parser("risks", help="List this project's accepted risks")
    risks.add_argument("--cwd", default=".")

    follow = sub.add_parser("follow", help="Continue the last GPT thread")
    follow.add_argument("text")
    follow.add_argument(
        "--project",
        action="store_true",
        help="Continue the project conversation even when this session has a "
             "review thread.",
    )
    add_common(follow)

    return parser


def dispatch(args, payload, resume_thread=None):
    """Shared tail: scan, preflight, dispatch, persist, print."""
    repo = Path(args.cwd).resolve()

    if args.model != runner.MODEL:
        # --model is a deliberate escape hatch, so it stays. But the result must
        # not be mistaken for the Sol review the tool exists to obtain.
        print(
            "warning: using --model " + args.model + " instead of " + runner.MODEL
            + ".\n         This is NOT the model this tool pins; judge the output "
              "accordingly.",
            file=sys.stderr,
        )

    findings = secrets.scan(payload)
    halting = bool(findings) and not args.allow_secrets

    # A dry run exists to be inspected, so its artifacts always survive -- and
    # so does a payload we refused to send, otherwise "inspect the payload"
    # names a file that was never written.
    with Artifacts(keep=args.keep or args.dry_run or halting) as art:
        payload_path = art.write("payload.md", payload)

        if halting:
            raise AskGptError(secrets.format_findings(findings, payload_path))

        if args.dry_run:
            print("DRY RUN -- nothing sent. Payload kept at " + str(payload_path))
            print()
            print(payload)
            return 0

        # Scan the whole repository, not --cwd. Codex operates inside the
        # enclosing repo and can read files above the requested subdirectory,
        # so scanning only the subdirectory leaves a `.env` one level up
        # exposed while reporting the tree clean.
        root = gitctx.repo_root(repo)

        # Two passes, because they miss different things. Filenames catch
        # `.env` and `*.pem`; content catches a live key pasted into an
        # ordinary source file, which Codex reads just as happily and which
        # filename matching cannot see.
        content_hits = preflight.scan_contents(root)
        if content_hits and not args.allow_sensitive_files:
            raise AskGptError(preflight.format_content_warning(content_hits))

        hits = preflight.scan_tree(root)
        if hits and not args.allow_sensitive_files:
            # Halt, do not narrate. Printing a warning and dispatching in the
            # same breath is not a protection: by the time the user reads it
            # the repository has already been sent, and under Claude Code the
            # output may not surface until Codex has finished.
            raise AskGptError(
                preflight.format_warning(hits)
                + "\n\nNothing was sent. Re-run with --allow-sensitive-files "
                  "if Codex reading these is acceptable."
            )

        codex_bin = codex.find_codex()
        codex.check_auth(codex_bin)

        result = runner.run(
            codex_bin,
            payload,
            cwd=repo,
            out_path=art.path("out.md"),
            model=args.model,
            resume_thread=resume_thread,
            fallback=not args.no_fallback,
        )

        if result.fell_back:
            # Unmissable: a weaker model's opinion must never be mistaken for
            # the one this tool exists to obtain.
            print(
                "=" * 68 + "\n"
                "NOTE: " + args.model + " was unavailable. This review is from "
                + result.model + ",\n"
                "      a weaker model. Weigh it accordingly, and re-run later "
                "for " + args.model + ".\n"
                + "=" * 68,
                file=sys.stderr,
            )

        # Ask/follow threads are project conversations, so they key by repo:
        # tomorrow's session continues today's discussion of this codebase.
        # Review stays keyed by session -- an independent reviewer must not
        # inherit its own past framing across runs.
        thread_key = getattr(args, "_thread_key", None) or args.session_id or getattr(
            args, "_fallback_session", None
        )
        if result.thread_id and thread_key:
            state.save_thread(state_dir(), thread_key, result.thread_id)

        if args.keep:
            print("Artifacts kept in " + str(art.dir), file=sys.stderr)

        # Always archive the complete response, so a truncated relay is
        # detectable by comparing against the recorded length and hash.
        archive, digest, size = state.archive_response(
            state_dir(), args.session_id, result.thread_id, result.text,
            payload=payload,
        )
        print(
            "full response: " + str(size) + " bytes, sha256:" + digest + "\n"
            "               " + str(archive),
            file=sys.stderr,
        )

        print(result.text)

        # Codex refreshed its own rate-limit record during that run, so this
        # costs nothing beyond reading a local file.
        footer = usage.format_footer(usage.read_latest(usage.sessions_dir()))
        if footer:
            print(footer, file=sys.stderr)
    return 0


def cmd_review(args):
    repo = Path(args.cwd).resolve()
    target = gitctx.resolve_target(
        repo, base=args.base, commit=args.commit, uncommitted=args.uncommitted
    )
    branch = gitctx.current_branch(repo)
    task, source = prompts.resolve_task(
        args.task, args.task_file, repo / "docs" / "superpowers" / "specs", branch
    )
    print(
        "Target: " + target.description + " (" + str(len(target.files)) + " files) | "
        "task source: " + source,
        file=sys.stderr,
    )
    accepted = ledger.load_accepted(state_dir(), gitctx.repo_root(repo))
    if accepted:
        print(
        "Including " + str(len(accepted)) + " accepted risk(s); `askgpt risks` lists them.",
            file=sys.stderr,
        )
    payload = prompts.build_review_payload(
        prompts.load_persona(REPO_ROOT),
        task,
        target,
        accepted_block=ledger.format_accepted_block(accepted),
    )
    return dispatch(args, payload)


def _packed_transcript(args):
    if not args.session_id:
        print(
            "warning: no --session-id given; falling back to the newest transcript by "
            "mtime.\n         With two Claude sessions open in this directory that can "
            "select the wrong one.",
            file=sys.stderr,
        )
    config_dir = Path(os.environ.get("CLAUDE_CONFIG_DIR", Path.home() / ".claude"))
    project_dir = transcript.project_dir_for(Path(args.cwd).resolve(), config_dir)
    path = transcript.resolve_session(project_dir, args.session_id)
    # Remember which transcript we actually used, so a follow-up can resume even
    # when no --session-id was given. Otherwise the call succeeds and `follow`
    # then reports "no prior thread" for a conversation that plainly happened.
    args._fallback_session = args.session_id or path.stem
    return transcript.pack(transcript.load_jsonl(path), drop_last_turns=1)


def cmd_ask(args):
    # repo_root, not cwd: asking from a subdirectory must continue the same
    # project conversation, not fork a second one.
    args._thread_key = "project-" + ledger.project_slug(
        gitctx.repo_root(Path(args.cwd).resolve())
    )
    payload = prompts.build_ask_payload(args.question, _packed_transcript(args))
    return dispatch(args, payload)


def cmd_accept(args):
    repo = gitctx.repo_root(Path(args.cwd).resolve())
    description = args.description
    if not description:
        # Best effort: pull the finding's own text out of the most recent
        # archived review, so the ledger entry describes what was accepted
        # even when the user only typed the ID.
        description = _finding_from_archive(args.finding_id)
    if not description:
        print(
            "askgpt: cannot identify " + args.finding_id + ". F-IDs are ordinals "
            "within one review,\nso an entry without a description matches nothing "
            "later. Pass --description\nwith file:line and the finding's own words.",
            file=sys.stderr,
        )
        return 1
    try:
        ledger.accept(state_dir(), repo, args.finding_id, args.reason, description)
    except ValueError as error:
        print("askgpt: " + str(error), file=sys.stderr)
        return 1
    print("Accepted " + args.finding_id + ": " + description[:80])
    return 0


def _finding_from_archive(finding_id):
    """The finding's text from the newest archived review mentioning its ID."""
    directory = state_dir() / "responses"
    if not directory.is_dir():
        return ""
    # Responses only. Payload sidecars share the .md suffix, so globbing
    # blindly can resolve a finding's text out of a PAYLOAD -- which contains
    # the previous ledger block, not the review that raised the finding.
    candidates = [
        p for p in directory.glob("*.md") if not p.name.endswith(".payload.md")
    ]
    for path in sorted(candidates, key=lambda p: p.stat().st_mtime, reverse=True):
        try:
            text = path.read_text(encoding="utf-8")
        except OSError:
            continue
        marker = finding_id + ":"
        for para in text.split("\n\n"):
            if finding_id in para.split("\n")[0] or marker in para:
                return " ".join(para.split())[:400]
    return ""


def cmd_unaccept(args):
    repo = gitctx.repo_root(Path(args.cwd).resolve())
    try:
        removed = ledger.unaccept(state_dir(), repo, args.finding_id)
    except ledger.Ambiguous as clash:
        print(
            "askgpt: '" + args.finding_id + "' matches "
            + str(len(clash.matches)) + " accepted risks. Ordinals repeat across\n"
            "reviews, so name the one you mean by description substring or key:",
            file=sys.stderr,
        )
        for entry in clash.matches:
            print("  " + entry["key"] + "  " + entry.get("description", "")[:70],
                  file=sys.stderr)
        return 1
    if removed:
        print("Removed " + args.finding_id)
        return 0
    print("askgpt: no accepted risk matching " + args.finding_id, file=sys.stderr)
    return 1


def cmd_risks(args):
    repo = gitctx.repo_root(Path(args.cwd).resolve())
    entries = ledger.load_accepted(state_dir(), repo)
    if not entries:
        print("No accepted risks recorded for " + str(repo))
        return 0
    for entry in entries:
        print("[" + entry.get("id", "?") + "] " + entry.get("accepted_at", "?")
              + "  key:" + entry.get("key", "?"))
        print("     " + entry.get("description", "")[:100])
        print("     reason: " + entry.get("reason", ""))
    return 0


def cmd_usage(args):
    print(usage.format_usage(usage.read_latest(usage.sessions_dir())))
    return 0


def cmd_follow(args):
    """Continue a conversation. Two distinct targets, chosen explicitly:

    A review thread from THIS session wins by default -- immediately after
    /gptreview, "follow" means "argue with that review", and routing it into
    an old advisory chat argues with the wrong context. The project chat is
    reached with --project. Crucially, following a review NEVER saves into
    the project key: promoting a memoryless reviewer's framing into permanent
    project memory would undo the separation on purpose built here.
    """
    project_key = "project-" + ledger.project_slug(
        gitctx.repo_root(Path(args.cwd).resolve())
    )
    session_thread = state.load_thread(state_dir(), args.session_id or "")

    if getattr(args, "project", False):
        args._thread_key = project_key
        thread_id = state.load_thread(state_dir(), project_key)
    elif session_thread:
        args._thread_key = args.session_id      # review follow stays session-keyed
        thread_id = session_thread
    else:
        args._thread_key = project_key
        thread_id = state.load_thread(state_dir(), project_key)
    if not thread_id and not args.session_id:
        # Mirror the ask-path fallback so an unkeyed ask can still be followed.
        try:
            config_dir = Path(os.environ.get("CLAUDE_CONFIG_DIR", Path.home() / ".claude"))
            project_dir = transcript.project_dir_for(Path(args.cwd).resolve(), config_dir)
            thread_id = state.load_thread(
                state_dir(), transcript.resolve_session(project_dir, None).stem
            )
        except AskGptError:
            thread_id = None
    if not thread_id:
        raise AskGptError(
            "No prior GPT thread for this session. Run `askgpt ask` or "
            "`askgpt review` first."
        )
    return dispatch(args, args.text, resume_thread=thread_id)


def main(argv=None):
    args = build_parser().parse_args(argv)
    handler = {
        "review": cmd_review,
        "ask": cmd_ask,
        "follow": cmd_follow,
        "usage": cmd_usage,
        "accept": cmd_accept,
        "unaccept": cmd_unaccept,
        "risks": cmd_risks,
    }[args.command]
    try:
        return handler(args)
    except AskGptError as error:
        print("askgpt: " + str(error), file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
